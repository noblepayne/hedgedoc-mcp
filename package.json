{
  "dependencies": {
    "socket.io-client": "^4.7.5",
    "squint-cljs": "0.9.174"
  },
  "name": "hedgedoc-mcp",
  "scripts": {
    "build": "npx squint compile",
    "start": "node hedgedoc_mcp/multi.mjs",
    "watch": "npx squint watch",
    "dev:up": "podman-compose -f dev/compose.yml up -d",
    "dev:seed": "node dev/seed.mjs",
    "dev:down": "podman-compose -f dev/compose.yml down -v",
    "test:pbt": "cd test && node pbt-1-gens.mjs && node pbt-2-transform.mjs --runs 1000 && node pbt-3-invariants.mjs && node pbt-4-replace-lines.mjs && node error-shape.mjs && node model-subtree.mjs && node affected-span.mjs && node intent.mjs && node section-boundary.mjs && node replace-range.mjs && node worker-diagnostics.mjs",
    "prepack": "npm run build",
    "test:socket": "node test/reconnect.mjs",
    "test:diagnostics": "node test/worker-diagnostics.mjs",
    "test:reconnect-live": "node test/reconnect-live.mjs"
  },
  "type": "module",
  "version": "0.2.4",
  "devDependencies": {
    "fast-check": "^4.10.2"
  },
  "bin": {
    "hedgedoc-mcp": "bin/hedgedoc-mcp.mjs"
  },
  "license": "MIT",
  "description": "Unofficial CAS-grounded MCP server for HedgeDoc 1.x: read and edit notes without clobbering humans",
  "repository": {
    "type": "git",
    "url": "https://github.com/noblepayne/hedgedoc-mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "hedgedoc_mcp/*.mjs",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/noblepayne/hedgedoc-mcp#readme",
  "bugs": {
    "url": "https://github.com/noblepayne/hedgedoc-mcp/issues"
  },
  "author": "Wes Payne",
  "keywords": [
    "hedgedoc",
    "mcp",
    "collaborative-editing",
    "cas",
    "socket.io"
  ]
}
