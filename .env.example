# Copy to .env for a local core.mjs run, or paste these into your MCP client.
HEDGEDOC_URL=https://hedgedoc.example.com
HEDGEDOC_NOTE_ID=replace-with-a-note-id
HEDGEDOC_EMAIL=bot@example.com
HEDGEDOC_PASSWORD=replace-with-a-bot-password

# Optional
# HEDGEDOC_CLIENT_MAJOR=4
# HEDGEDOC_TRANSPORTS=websocket
# HEDGEDOC_POLL_TIMEOUT_MS=10000
# HEDGEDOC_POLL_MS=500
# HEDGEDOC_MAX_NOTES=8
# HEDGEDOC_ALLOW_GUEST_WRITES=false
# HEDGEDOC_ENABLE_SET_NOTE=false
# HEDGEDOC_IDLE_MS=30000
